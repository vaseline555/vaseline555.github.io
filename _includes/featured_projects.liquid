{% assign featured_projects = site.projects | sort: 'importance' %}
{% if include.limit %}
  {% assign featured_limit = include.limit %}
{% else %}
  {% assign featured_limit = 3 %}
{% endif %}

<div class="projects">
  <div class="row row-cols-1 row-cols-md-2">
    {% for project in featured_projects limit: featured_limit %}
      {% include projects_horizontal.liquid %}
    {% endfor %}
  </div>
</div>
